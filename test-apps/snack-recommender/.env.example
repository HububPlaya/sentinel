# Local development only -- nothing here is used when running on AWS. Elastic
# Beanstalk sets DB_HOST/DB_PORT/DB_NAME/DB_SECRET_ARN itself; see
# docs/elastic-beanstalk/deploy-flow.md for how.

# Optional -- defaults to a local SQLite file if unset.
# DATABASE_URL=postgresql://user:password@localhost:5432/snack_recommender

# Optional -- defaults to an insecure placeholder if unset.
# SECRET_KEY=change-me